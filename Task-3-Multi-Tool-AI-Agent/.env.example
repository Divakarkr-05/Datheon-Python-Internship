# ==============================================================================
# Datheon Internship Task 3: Multi-Tool Autonomous AI Agent
# Environment Configuration Template
# ==============================================================================

# Google Gemini API Key (Required for Agent LLM)
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Alternative standard alias supported:
# GOOGLE_API_KEY=your_gemini_api_key_here

# LLM Model Configuration
GEMINI_MODEL=gemini-3.8-flash-lite
GEMINI_TEMPERATURE=0.0

# Web Search Provider: 'duckduckgo' (default, no API key required) or 'tavily'
SEARCH_PROVIDER=duckduckgo
SEARCH_MAX_RESULTS=5

# Optional: Tavily API Key (Only needed if SEARCH_PROVIDER=tavily)
# Get a key at https://tavily.com
TAVILY_API_KEY=

# Agent Execution Limits
MAX_ITERATIONS=10

# Security & Data Directory
# Relative or absolute path to local data directory for the file reader tool
DATA_DIR=data
MAX_FILE_SIZE_BYTES=10485760
